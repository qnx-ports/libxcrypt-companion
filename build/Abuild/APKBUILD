# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=libxcrypt
pkgver=4.4.38
pkgrel=${pkgrel:-0}
pkgdesc="Extended crypt library for descrypt, md5crypt, bcrypt, and others"
url="https://github.com/besser82/libxcrypt"
arch="all"
license="LGPL-2.1"
makedepends="perl autoconf automake"
#options="!check"
source="https://github.com/besser82/$pkgname/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz
        printf-null.patch
"
subpackages="$pkgname-doc $pkgname-dev"
build() {
    CPPFLAGS="$CPPFLAGS -DSA_RESTART=0" \
    CFLAGS="$CFLAGS -Wno-undef -Os" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --enable-static \
        --enable-hashes=strong,glibc \
        --enable-obsolete-api=glibc \
        --disable-failure-tokens

    make
}

check(){
    make check 
}

package() {
    make DESTDIR="$pkgdir" install
}

options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
